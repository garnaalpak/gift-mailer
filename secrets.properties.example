# Konfiguracja serwera SMTP (domyślnie dla Gmail)
smtp.host=smtp.gmail.com
smtp.port=587

# Dane logowania (dla Gmaila użyj 16-znakowego "Hasła do aplikacji" z ustawień konta Google, bez spacji)
smtp.user=your.email@gmail.com
smtp.password=your_16_char_app_password

# Tryb testowy:
# true  = tylko wypisuje wylosowane pary w konsoli (nie wysyła maili)
# false = faktycznie wysyła maile do uczestników
dry.run=true